{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskpanel-spike",
  "version": "0.0.1",
  "identifier": "dev.darshan.deskpanel.spike",
  "build": { "frontendDist": "./dist" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "deskpanel-spike-main",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "pill",
        "title": "deskpanel-spike-pill",
        "url": "pill.html",
        "width": 200,
        "height": 36,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
